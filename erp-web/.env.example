# 默认关闭全局 Mock 层，再按模块开关分阶段迁移真实 API。
VITE_USE_MOCK=false
# 关闭全局 Mock 后，模块变量仅在明确设为 false 时切到真实 API。
# 当前阶段：商品与 Dashboard 走真实 API；认证、订单和库存仍可独立使用 Mock。
VITE_AUTH_USE_MOCK=true
VITE_PRODUCTS_USE_MOCK=false
# Bestsellers Mock is independent of VITE_USE_MOCK. Keep false for backend integration.
VITE_BESTSELLERS_USE_MOCK=false
# Bestsellers rollout starts with one stable platform shop ID; switch to all only after acceptance.
VITE_BESTSELLERS_ROLLOUT_STAGE=single
VITE_BESTSELLERS_PRODUCTION_SHOP_ID=<platform-shop-id>
VITE_ORDERS_USE_MOCK=true
VITE_DASHBOARD_USE_MOCK=false
VITE_INVENTORY_USE_MOCK=true
# Data Mock is deliberately independent of VITE_USE_MOCK. Set true only for UI development.
VITE_DATA_USE_MOCK=false
# Finance Mock is independent and enabled only when explicitly set to true.
VITE_FINANCE_USE_MOCK=false
# placeholder immediately restores the old unavailable page; test, single and all are the rollout stages.
VITE_DATA_ROLLOUT_STAGE=test
VITE_DATA_TEST_SHOP_IDS=
VITE_DATA_PRODUCTION_SHOP_ID=<platform-shop-id>
# Production: set VITE_USE_MOCK=false so the backend issues and validates captchas.

# 浏览器请求的 API 前缀；开发服务器会代理该前缀以避免跨域。
VITE_API_BASE_URL=/api
VITE_API_CONTRACT_VERSION=v1

# 仅开发环境使用：Vite 将 /api 转发到此后端地址。
VITE_API_PROXY_TARGET=http://localhost:8080

# 可替换的错误上报和性能指标接入位（留空则不发送网络请求）
VITE_OBSERVABILITY_ENABLED=true
VITE_ERROR_REPORTING_ENDPOINT=
VITE_METRICS_ENDPOINT=
# 发布元数据会随每条事件上报，用 CI/CD 的构建变量覆盖
VITE_RELEASE_ENVIRONMENT=development
VITE_RELEASE_VERSION=local

# 所有 VITE_* 值都会进入浏览器构建产物。严禁在此添加 TikTok 密钥、Token 加密密钥、
# DATABASE_URL、数据库密码、JWT 密钥或任何其他服务端凭据。
