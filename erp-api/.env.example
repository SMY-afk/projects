# Reference only. Copy the environment-specific template for local use.
APP_ENV=<development|test|production>
API_PREFIX=</api/v1>
API_HOST=<listen-address>
API_PORT=<listen-port>
API_RELOAD=<true|false>
CORS_ORIGINS=<comma-separated-browser-origins>
CORS_ALLOW_CREDENTIALS=<true|false>
LOG_LEVEL=<log-level>

POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=
POSTGRES_DB=<database-name>
LOGISTICS_EXCEPTION_PICKUP_TIMEOUT_HOURS=24
LOGISTICS_EXCEPTION_STALLED_TIMEOUT_HOURS=72
LOGISTICS_EXCEPTION_PLATFORM_GRACE_HOURS=2
DATABASE_URL=<postgresql-async-connection-url>
REDIS_URL=<redis-connection-url>

AUTH_CAPTCHA_HMAC_SECRET=
AUTH_CAPTCHA_TTL_SECONDS=<seconds>
AUTH_ACCESS_TOKEN_TTL_SECONDS=<seconds>
AUTH_LOGIN_MAX_ATTEMPTS=<count>
AUTH_LOGIN_RATE_LIMIT_SECONDS=<seconds>

TIKTOK_APP_KEY=<tiktok-app-key>
TIKTOK_SERVICE_ID=<tiktok-service-id>
TIKTOK_APP_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
TIKTOK_301_APP_KEY=<tiktok-us-app-key>
TIKTOK_301_SERVICE_ID=<tiktok-us-service-id>
TIKTOK_301_APP_SECRET=
TIKTOK_301_AUTHORIZATION_URL=https://services.us.tiktokshop.com/open/authorize
TIKTOK_AUTHORIZATION_URL=<tiktok-authorization-url>
TIKTOK_CREATOR_AUTHORIZATION_URL=https://shop.tiktok.com/alliance/creator/auth
TIKTOK_TOKEN_URL=<tiktok-token-url>
TIKTOK_SHOP_IDENTITY_URL=<tiktok-shop-identity-url>
TIKTOK_FINANCE_STATEMENTS_PATH=/finance/202309/statements
TIKTOK_FINANCE_PAYMENTS_PATH=/finance/202605/payments
TIKTOK_FINANCE_STATEMENT_TRANSACTIONS_PATH=/finance/202501/statements/{statement_id}/statement_transactions
TIKTOK_FINANCE_ORDER_TRANSACTIONS_PATH=/finance/202501/orders/{order_id}/statement_transactions
TIKTOK_FINANCE_UNSETTLED_TRANSACTIONS_PATH=/finance/202507/orders/unsettled
TIKTOK_FINANCE_MAX_WINDOW_DAYS=30
TIKTOK_FINANCE_RAW_PAYLOAD_TTL_DAYS=30
TIKTOK_FINANCE_INITIAL_SYNC_DAYS=30
TIKTOK_FINANCE_INCREMENTAL_OVERLAP_HOURS=24
TIKTOK_FINANCE_ORDER_DETAIL_CONCURRENCY=4
TIKTOK_FINANCE_SYNC_HOUR_UTC=6
TIKTOK_FINANCE_SYNC_MINUTE_UTC=0
TIKTOK_FINANCE_JOB_MAX_TRIES=5
FINANCE_EXPORT_MAX_ROWS=100000
# One-time Gate 0 probe values only. Never store real creator tokens here.
TIKTOK_CREATOR_PROBE_ACCESS_TOKEN=
TIKTOK_CREATOR_PROBE_USER_TYPE=<1>
TIKTOK_CREATOR_PROBE_GRANTED_SCOPES=<comma-separated-creator-scopes>
# Custom scope required: seller.affiliate_collaboration.read
TIKTOK_AFFILIATE_ORDER_URL=https://open-api.tiktokglobalshop.com/affiliate_seller/202410/orders/search
# Keep both values unset unless TikTok grants an order-level Ads conversion endpoint.
# GMV Max reporting endpoints are aggregate-only and are not compatible here.
TIKTOK_ADS_ORDER_URL=
TIKTOK_ADS_ACCESS_TOKEN=
FEISHU_APP_ID=
# Server-only secret used by the fixed two-table affiliate export.
FEISHU_APP_SECRET=
# Shared only with the local creator-invitation backend. Use 32+ random characters.
AFFILIATE_EXPORT_SERVICE_TOKEN=
# Tenant UUID whose five Affiliate Center shops may be read by the service token.
AFFILIATE_EXPORT_TENANT_ID=
TIKTOK_VIDEO_ANALYTICS_URL=https://open-api.tiktokglobalshop.com/analytics/202605/shop_videos/performance
TIKTOK_VIDEO_ANALYTICS_OVERVIEW_URL=https://open-api.tiktokglobalshop.com/analytics/202509/shop_videos/overview_performance
TIKTOK_VIDEO_ANALYTICS_ITEMS_PATH=videos
TIKTOK_VIDEO_ANALYTICS_NEXT_PAGE_TOKEN_PATH=next_page_token
TIKTOK_VIDEO_ANALYTICS_FIELD_MAP={"videoId":"id","title":"title","username":"username","creatorOpenId":"creator.open_id","creatorUsername":"creator.user_name","creatorNickname":"creator.nick_name","creatorAuthorType":"creator.author_type","videoPostTime":"video_post_time","durationSeconds":"duration","hashTags":"hash_tags","gmvAmount":"gmv.amount","gmvCurrency":"gmv.currency","gpmAmount":"gpm.amount","gpmCurrency":"gpm.currency","views":"views","skuOrders":"sku_orders","itemsSold":"items_sold","averageCustomers":"avg_customers","clickThroughRate":"click_through_rate","promotedProducts":"products"}
TIKTOK_VIDEO_ANALYTICS_EXTERNAL_ID_FIELD=videoId
TIKTOK_VIDEO_ANALYTICS_AMOUNT_CURRENCY_PAIRS={"gmvAmount":"gmvCurrency","gpmAmount":"gpmCurrency"}
TIKTOK_VIDEO_ANALYTICS_REQUIRED_FIELDS=["videoId"]
TIKTOK_VIDEO_ANALYTICS_SOURCE_UPDATED_AT_PATH=<source-timestamp-path-relative-to-data>
TIKTOK_VIDEO_ANALYTICS_ITEM_SOURCE_UPDATED_AT_PATH=<source-timestamp-path-relative-to-item>
TIKTOK_VIDEO_ANALYTICS_STATUS_PATH=<status-path-relative-to-item>
TIKTOK_VIDEO_ANALYTICS_STATUS_MAP=<json-object-of-platform-status-to-internal-status>
TIKTOK_VIDEO_ANALYTICS_MAX_WINDOW_DAYS=30
TIKTOK_LIVE_ANALYTICS_URL=https://open-api.tiktokglobalshop.com/analytics/202509/shop_lives/performance
TIKTOK_LIVE_ANALYTICS_OVERVIEW_URL=https://open-api.tiktokglobalshop.com/analytics/202509/shop_lives/overview_performance
TIKTOK_LIVE_ANALYTICS_ITEMS_PATH=live_stream_sessions
TIKTOK_LIVE_ANALYTICS_NEXT_PAGE_TOKEN_PATH=next_page_token
TIKTOK_LIVE_ANALYTICS_FIELD_MAP={"liveId":"id","title":"title","username":"username","startTime":"start_time","endTime":"end_time","gmvAmount":"sales_performance.gmv.amount","gmvCurrency":"sales_performance.gmv.currency","productsAdded":"sales_performance.products_added","differentProductsSold":"sales_performance.different_products_sold","createdSkuOrders":"sales_performance.created_sku_orders","skuOrders":"sales_performance.sku_orders","itemsSold":"sales_performance.items_sold","customers":"sales_performance.customers","averagePriceAmount":"sales_performance.avg_price.amount","averagePriceCurrency":"sales_performance.avg_price.currency","clickToOrderRate":"sales_performance.click_to_order_rate","clickThroughRate":"sales_performance.click_through_rate","live24hGmvAmount":"sales_performance.24h_live_gmv.amount","live24hGmvCurrency":"sales_performance.24h_live_gmv.currency"}
TIKTOK_LIVE_ANALYTICS_EXTERNAL_ID_FIELD=liveId
TIKTOK_LIVE_ANALYTICS_AMOUNT_CURRENCY_PAIRS={"gmvAmount":"gmvCurrency","averagePriceAmount":"averagePriceCurrency","live24hGmvAmount":"live24hGmvCurrency"}
TIKTOK_LIVE_ANALYTICS_REQUIRED_FIELDS=["liveId"]
TIKTOK_LIVE_ANALYTICS_SOURCE_UPDATED_AT_PATH=<source-timestamp-path-relative-to-data>
TIKTOK_LIVE_ANALYTICS_ITEM_SOURCE_UPDATED_AT_PATH=<source-timestamp-path-relative-to-item>
TIKTOK_LIVE_ANALYTICS_STATUS_PATH=<status-path-relative-to-item>
TIKTOK_LIVE_ANALYTICS_STATUS_MAP=<json-object-of-platform-status-to-internal-status>
TIKTOK_LIVE_ANALYTICS_MAX_WINDOW_DAYS=30
TIKTOK_ANALYTICS_RAW_PAYLOAD_TTL_DAYS=30
AFFILIATE_CENTER_RAW_PAYLOAD_TTL_DAYS=7
AFFILIATE_CONCURRENCY=5
AFFILIATE_CREATOR_STALE_HOURS=24
AFFILIATE_DETAIL_BACKFILL_MAX_CREATORS=5000
AFFILIATE_DETAIL_BACKFILL_MAX_PAGES=500
TIKTOK_ANALYTICS_INITIAL_SYNC_DAYS=30
TIKTOK_ANALYTICS_SYNC_HOUR_UTC=4
TIKTOK_ANALYTICS_SCHEDULE=daily
TIKTOK_ANALYTICS_SYNC_MINUTE_UTC=0
TIKTOK_BESTSELLER_SYNC_HOUR_UTC=5
TIKTOK_BESTSELLER_SYNC_MINUTE_UTC=0
TIKTOK_ANALYTICS_JOB_MAX_TRIES=5
SYNC_HEALTH_WINDOW_HOURS=168
SYNC_HEALTH_EXPECTED_INTERVAL_MINUTES=1440
TIKTOK_TOKEN_ENCRYPTION_KEY=
TIKTOK_WEBHOOK_SIGNING_SECRET=
ORDER_PII_ENCRYPTION_KEY=
ORDER_INITIAL_BACKFILL_DAYS=30
ORDER_SYNC_INTERVAL_MINUTES=10
ORDER_PII_RETENTION_DAYS=90
TIKTOK_CALLBACK_BASE_URL=<public-https-callback-base-url>
TIKTOK_OAUTH_STATE_TTL_SECONDS=<seconds>
TIKTOK_REQUEST_TIMEOUT_SECONDS=<seconds>
TIKTOK_REQUEST_MAX_RETRIES=<count>
TIKTOK_RETRY_BASE_SECONDS=<seconds>
TIKTOK_MAX_RETRY_DELAY_SECONDS=<seconds>

# Feishu sample Base and event callback. Keep all secret values server-side.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_SAMPLE_BASE_TOKEN=
FEISHU_COOP_STROLLER_BASE_TOKEN=
FEISHU_COOP_STROLLER_TABLE_ID=
FEISHU_COOP_STROLLER_VIEW_ID=
FEISHU_COOP_RC_BASE_TOKEN=
FEISHU_COOP_RC_TABLE_ID=
FEISHU_COOP_RC_VIEW_ID=
FEISHU_DAILY_VALID_CREATOR_TABLE_ID=
FEISHU_SAMPLE_TABLE_ID=
FEISHU_BD_ASSIGNMENT_RECORD_TABLE_ID=
FEISHU_BD_INVITATION_PROTECTION_TABLE_ID=
FEISHU_AI_INVITATION_BASE_TOKEN=
FEISHU_AI_INVITATION_TABLE_ID=
FEISHU_ASSIGNMENT_SUMMARY_SYNC_ENABLED=false
FEISHU_ASSIGNMENT_SUMMARY_TABLE_ID=
FEISHU_ASSIGNMENT_SUMMARY_SHOP_IDS=
FEISHU_ASSIGNMENT_SUMMARY_BD_NAMES=
FEISHU_ASSIGNMENT_SUMMARY_BD_ALIASES=
FEISHU_ASSIGNMENT_SUMMARY_SYNC_INTERVAL_SECONDS=300
FEISHU_EVENT_VERIFICATION_TOKEN=<feishu-event-verification-token>
FEISHU_EVENT_ENCRYPT_KEY=<feishu-event-encrypt-key>
FEISHU_SAMPLE_REVERSE_POLL_ENABLED=false
FEISHU_SAMPLE_REVERSE_POLL_INTERVAL_MINUTES=5
FEISHU_SAMPLE_NOTIFICATION_ENABLED=false
FEISHU_SAMPLE_RECORD_URL_TEMPLATE=https://example.invalid/configure-resource<base-token>?table=<table-id>&view=<view-id>&record={record_id}
FEISHU_SAMPLE_NOTIFICATION_TEST_RECIPIENT_OPEN_ID=
FEISHU_SAMPLE_NOTIFICATION_LIVE_RECIPIENTS_ENABLED=false
FEISHU_SAMPLE_NOTIFICATION_GROUP_CHAT_ID=<notification-group-chat-id>
FEISHU_SAMPLE_NOTIFICATION_MAX_ATTEMPTS=5
FEISHU_SAMPLE_NOTIFICATION_RETRY_BASE_SECONDS=30
FEISHU_SAMPLE_NOTIFICATION_PROCESSING_TIMEOUT_MINUTES=10
TIKTOK_SAMPLE_SYNC_JOB_MAX_TRIES=5
TIKTOK_SAMPLE_SHOP_LOCK_RETRY_SECONDS=30
TIKTOK_SAMPLE_FAST_JOB_TIMEOUT_SECONDS=900
TIKTOK_SAMPLE_FULL_JOB_TIMEOUT_SECONDS=3600
TIKTOK_SAMPLE_SHUTDOWN_GRACE_SECONDS=120

# Akeleo Toys only. Keep credentials server-side and bind IPC to loopback.
ZINIAO_WEBDRIVER_URL=http://127.0.0.1:16888
ZINIAO_COMPANY=
ZINIAO_USERNAME=
ZINIAO_PASSWORD=
ZINIAO_AKELEO_BROWSER_NAME=<exact-ziniao-browser-name>
ZINIAO_CHROMEDRIVER_PATH=<absolute-matching-chromedriver-path>

# One-time administrator bootstrap inputs. Prefer a protected shell/CI variable for the password.
INITIAL_TENANT_NAME=<tenant-name>
INITIAL_ADMIN_USERNAME=<admin-username>
INITIAL_ADMIN_PASSWORD=
MINIO_ROOT_USER=<local-minio-user>
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=erp-logistics
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=<same-as-minio-root-user>
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=erp-logistics
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_KEY_PREFIX=
OBJECT_STORAGE_PRESIGNED_TTL_SECONDS=900
LOGISTICS_DOCUMENT_MAX_BYTES=10485760
TIKTOK_FULFILLMENT_SHIP_PATH_TEMPLATE=/fulfillment/202309/packages/{package_id}/ship
PLATFORM_FULFILLMENT_JOB_MAX_TRIES=5
PLATFORM_FULFILLMENT_RETRY_BASE_SECONDS=30
PLATFORM_FULFILLMENT_PROCESSING_TIMEOUT_MINUTES=10
# JSON object keyed by TENANT_UUID:CARRIER_CODE (preferred), carrier code, or adapter key.
LOGISTICS_WEBHOOK_SIGNING_SECRETS=
LOGISTICS_TRACKING_POLL_INTERVAL_MINUTES=30
LOGISTICS_TRACKING_POLL_RETRY_MINUTES=10
TIKTOK_LOGISTICS_SYNC_JOB_TIMEOUT_SECONDS=900
